# SentinelCloud-Advanced Environment Configuration
# ================================================
# Copy to .env and customize:
#   cp .env.example .env

# ── Operating Mode ──
# dev  = single machine, no infra required
# lab  = Docker Compose local lab
# live = Full K8s cluster
SENTINEL_MODE=dev

# ── Authentication ──
# CHANGE THESE IN PRODUCTION
SENTINEL_ADMIN_USER=admin
SENTINEL_ADMIN_PASSWORD=sentinel-admin-2026
SENTINEL_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32

# Optional analyst user
# SENTINEL_ANALYST_USER=analyst
# SENTINEL_ANALYST_PASSWORD=analyst-2026

# ── Server ──
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=5050
SENTINEL_DEBUG=false
SENTINEL_CORS_ORIGINS=http://localhost:3000,http://localhost:5050

# ── Infrastructure (enable in lab/live mode) ──
SENTINEL_KAFKA_ENABLED=false
SENTINEL_KAFKA_BOOTSTRAP=localhost:9092
SENTINEL_CLICKHOUSE_ENABLED=false
SENTINEL_CLICKHOUSE_HOST=localhost
SENTINEL_CLICKHOUSE_PORT=9000
SENTINEL_KUBERNETES_ENABLED=false

# ── Medical Services ──
SENTINEL_VITALS_URL=http://localhost:5000
SENTINEL_DRUG_DISPENSER_URL=http://localhost:5001
SENTINEL_EHR_URL=http://localhost:5002
SENTINEL_BILLING_URL=http://localhost:5003

# ── Intelligence Services ──
SENTINEL_ANOMALY_DETECTOR_URL=http://localhost:8080
SENTINEL_DIAGNOSIS_SERVICE_URL=http://localhost:8081
SENTINEL_DETECTOR_ENABLED=true

# ── ML Thresholds ──
SENTINEL_ANOMALY_THRESHOLD=0.72
SENTINEL_HMM_THRESHOLD=-5.0
SENTINEL_HMM_WINDOW_SIZE=10

# ── Persistence ──
SENTINEL_SQLITE_PATH=./data/sentinel.db

# ── Tetragon ──
SENTINEL_TETRAGON_ENABLED=false

# ── Prometheus ──
SENTINEL_PROMETHEUS_ENABLED=true
